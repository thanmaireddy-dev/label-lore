# PostgreSQL credentials for local Docker development
POSTGRES_USER="label_lore"
POSTGRES_PASSWORD="replace_with_a_local_password"
POSTGRES_DB="label_lore"
POSTGRES_PORT="5432"

# Prisma PostgreSQL connection
# Keep credentials consistent with the values above.
DATABASE_URL="postgresql://label_lore:replace_with_a_local_password@localhost:5432/label_lore?schema=app"

# Open Food Facts
OPEN_FOOD_FACTS_USER_AGENT="LabelLore/0.3.0 (https://your-domain.example)"

# App configuration
NEXT_PUBLIC_APP_VERSION="0.3.0"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"