# Local PostgreSQL credentials used by docker-compose.yml. Replace the example
# password before use outside a private development machine.
POSTGRES_USER="label_lore"
POSTGRES_PASSWORD="label_lore_local_only"
POSTGRES_DB="label_lore"
POSTGRES_PORT="5432"

# Prisma creates and manages the `app` and `food` schemas in this database.
DATABASE_URL="postgresql://label_lore:label_lore_local_only@localhost:5432/label_lore?schema=app"

# Optional: identify the application to Open Food Facts. The default uses NEXT_PUBLIC_SITE_URL.
# Use a real public site URL or contact URL in deployed environments.
OPEN_FOOD_FACTS_USER_AGENT="LabelLore/0.3.0 (https://your-domain.example)"

# App Configuration
NEXT_PUBLIC_APP_VERSION="0.3.0"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
